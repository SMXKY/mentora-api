# Application
NODE_ENV=
PORT=
FRONTEND_URL=

# Comma-separated list of allowed CORS origins
# Development: http://localhost:5173
# Staging: https://staging.mentora.cm
# Production: https://mentora.cm
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=
DATABASE_URL_TEST=

# Redis
REDIS_URL=

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# NotchPay
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_SECRET_KEY=
NOTCHPAY_WEBHOOK_SECRET=

# LiveKit (self-hosted via docker-compose "livekit" service — docker/livekit/livekit.yaml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Meilisearch (self-hosted via docker-compose "meilisearch" service, tutor search only)
# Development: http://localhost:7700 (published to the host)
# Production: http://meilisearch:7700 (internal Docker network only, see docker-compose.prod.yml)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=

# GeoLite2 (optional — IP-based location fallback for home-tutor geo search,
# see docs/services/tutor-search.doc.md. Unset means this fallback tier is
# skipped, not an error.)
GEOLITE2_DB_PATH=

# No API key needed for npm run search:backfill-cities, it geocodes via
# OpenStreetMap's free Nominatim search, see cli/backfillCityCoordinates.ts.

# Interserver Storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=

# Cloudflare CDN
CDN_BASE_URL=

# Resend (Email)
RESEND_API_KEY=

# Firebase (Push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Flagsmith
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_API_URL=

# PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=

# Sentry
SENTRY_DSN=

# Wallet
WALLET_MIN_TOPUP=

# Docs
DOCS_USERNAME=
DOCS_PASSWORD=